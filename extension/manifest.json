{
  "manifest_version": 3,
  "name": "WhatsApp Bulk Sender Helper",
  "version": "1.0.0",
  "description": "Lets the Tap to Send page send your message to every number automatically through WhatsApp Web.",
  "permissions": ["storage", "alarms"],
  "host_permissions": ["https://web.whatsapp.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://ovastaapp.github.io/whatsapp-bulk-sender/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": ["page-bridge.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["whatsapp.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
